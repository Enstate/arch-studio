{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "**",
      "!**/_generated",
      "!packages/agent/src/codex-app-server",
      "!**/routeTree.gen.ts",
      "!**/env.ts",
      "!**/*.d.ts",
      "!packages/ui/src/components",
      "!**/library",
      "!**/plans/**/*.json",
      "!.claude"
    ]
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "formatter": {
    "enabled": false
  },
  "assist": {
    "enabled": false
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "style": {
        "noRestrictedImports": {
          "level": "error",
          "options": {
            "paths": {
              "react": {
                "importNames": [
                  "useEffect",
                  "useLayoutEffect"
                ],
                "message": "Use derived state, handlers, useSyncExternalStore or useMountEffect (@arch/ui/hooks/use-mount-effect)."
              }
            }
          }
        },
        "noNonNullAssertion": "off"
      },
      "suspicious": {
        "noArrayIndexKey": "off",
        "noConfusingVoidType": "off"
      },
      "a11y": {
        "noSvgWithoutTitle": "off"
      },
      "correctness": {
        "noUnusedImports": "error"
      },
      "complexity": {
        "noImportantStyles": "off"
      }
    }
  },
  "overrides": [
    {
      "includes": [
        "packages/ui/src/hooks/use-mount-effect.ts"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": "off"
          }
        }
      }
    },
    {
      "includes": [
        "packages/renderer/template/src/**"
      ],
      "linter": {
        "rules": {
          "suspicious": {
            "noAssignInExpressions": "off",
            "useIterableCallbackReturn": "off"
          }
        }
      }
    }
  ]
}
